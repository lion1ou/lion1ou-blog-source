003E \u003Cspan class=\"hljs-selector-tag\"\u003Ethe\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eimage\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Estored\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ein\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ethe\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Evariable\u003C\u002Fspan\u003E `\u003Cspan class=\"hljs-selector-tag\"\u003Eimage\u003C\u002Fspan\u003E`. \u003Cspan class=\"hljs-selector-tag\"\u003EThe\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Equestion\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eis\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ein\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003EFrench\u003C\u002Fspan\u003E.\n  \u003Cspan class=\"hljs-selector-tag\"\u003EYou\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ehave\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ebeen\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eprovided\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ewith\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ethese\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eadditional\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Earguments\u003C\u002Fspan\u003E, \u003Cspan class=\"hljs-selector-tag\"\u003Ethat\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eyou\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ecan\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eaccess\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eusing\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ethe\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Ekeys\u003C\u002Fspan\u003E \u003Cspan class=\"hljs-selector-tag\"\u003Eas\u00