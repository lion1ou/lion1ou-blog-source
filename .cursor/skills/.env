# lion1ou Skills 环境变量配置
# 请填入你的 API Keys

# Tavily 搜索 API (用于 lion1ou-search-tools)
# 获取地址: https://tavily.com
TAVILY_API_KEY=

# OpenAI API (用于 baoyu-image-gen 图片生成)
# 获取地址: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 微信公众号 API (用于 baoyu-post-to-wechat)
# 获取地址: 微信公众平台 -> 开发 -> 基本配置
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 小红书 MCP 端点 (可选)
# XIAOHONGSHU_MCP_URL=https://xhs.n.lion1ou.tech:16666/mcp
