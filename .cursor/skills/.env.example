# lion1ou skills 统一环境变量配置
# 复制为 .cursor/skills/.env 后填写真实值；.baoyu-skills/.env 会软链到同一个文件。

# Tavily 搜索 API（lion1ou-search-tools）
TAVILY_API_KEY=

# GitHub 搜索 API（可选，用于提高 GitHub 搜索限额）
GITHUB_TOKEN=

# 小红书 MCP 搜索源
XIAOHONGSHU_MCP_URL=https://xhs.n.lion1ou.tech:16666/mcp
XHS_MCP_URL=

# Google 搜索源可选变量
DDG_GOOGLE_KEY=
GROQ_API_KEY=

# web-access CDP proxy 端口
CDP_PROXY_PORT=3456

# baoyu 生图后端：任选一个或多个配置。模型、质量、比例、并发等偏好写在 EXTEND.md。
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=
AZURE_API_VERSION=2025-04-01-preview
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
ZAI_API_KEY=
BIGMODEL_API_KEY=
ZAI_BASE_URL=
BIGMODEL_BASE_URL=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
REPLICATE_API_TOKEN=
REPLICATE_BASE_URL=
JIMENG_ACCESS_KEY_ID=
JIMENG_SECRET_ACCESS_KEY=
JIMENG_REGION=cn-north-1
JIMENG_BASE_URL=
ARK_API_KEY=
SEEDREAM_BASE_URL=

# OpenRouter 可选 attribution
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=

# Codex CLI 生图后端
BAOYU_CODEX_IMAGEGEN_BIN=
BAOYU_CODEX_IMAGEGEN_CACHE_DIR=
BAOYU_CODEX_IMAGEGEN_TIMEOUT_MS=
BAOYU_CODEX_IMAGEGEN_RETRIES=
BAOYU_CODEX_IMAGEGEN_LOG_FILE=

# Gemini Web 反向 API
GEMINI_WEB_DATA_DIR=
GEMINI_WEB_COOKIE_PATH=
GEMINI_WEB_CHROME_PROFILE_DIR=
GEMINI_WEB_CHROME_PATH=
BAOYU_CHROME_PROFILE_DIR=
HTTP_PROXY=
HTTPS_PROXY=

# X / Twitter 反向 API
X_AUTH_TOKEN=
X_CT0=
X_GUEST_TOKEN=
X_TWID=

# 微信公众号 API（baoyu-post-to-wechat API 模式）
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 微信公众号多账号配置示例：WECHAT_<ALIAS>_APP_ID / WECHAT_<ALIAS>_APP_SECRET
WECHAT_ALIAS_APP_ID=
WECHAT_ALIAS_APP_SECRET=
